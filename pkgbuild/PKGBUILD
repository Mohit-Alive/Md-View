pkgname=mdview
pkgver=0.1.0
pkgrel=1
pkgdesc='Show Markdown files the way GitHub renders them, in the Omarchy theme'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-webengine' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/mdview "$pkgdir/usr/bin/mdview"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  for notice in src/web/vendor/licenses/*.txt; do
    install -Dm644 "$notice" "$pkgdir/usr/share/licenses/$pkgname/third-party/$(basename "$notice")"
  done
  install -Dm644 "$startdir/mdview.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/mdview.svg"
  install -Dm644 "$startdir/mdview.desktop" "$pkgdir/usr/share/applications/mdview.desktop"
}
